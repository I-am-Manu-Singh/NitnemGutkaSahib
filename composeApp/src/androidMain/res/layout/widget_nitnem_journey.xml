<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/widgetRoot"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="16dp"

    android:gravity="center_vertical"

    android:clipToPadding="false"

    android:background="@drawable/widget_hero_background">

    <!-- TOP SECTION -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center_vertical">

        <!-- ICON -->

        <LinearLayout

            android:layout_width="56dp"
            android:layout_height="56dp"

            android:gravity="center"

            android:padding="12dp"

            android:background="@drawable/widget_icon_circle">

            <TextView

                android:id="@+id/widgetPrayerEmoji"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="🌇"

                android:textSize="26sp"

                android:textStyle="bold"

                android:textColor="#FFD369"/>
        </LinearLayout>

        <!-- TITLES -->

        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:paddingStart="14dp"

            android:paddingEnd="10dp">

            <TextView

                android:id="@+id/widgetTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Recharge Spiritually"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:textSize="20sp"

                android:maxLines="1"

                android:ellipsize="end"/>

            <TextView

                android:id="@+id/widgetSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="2dp"

                android:text="Rehras Sahib"

                android:textColor="#CCFFFFFF"

                android:textSize="13sp"

                android:maxLines="1"

                android:ellipsize="end"/>
        </LinearLayout>

        <!-- STREAK CHIP -->

        <LinearLayout

            android:layout_width="wrap_content"
            android:layout_height="34dp"

            android:paddingStart="14dp"
            android:paddingEnd="14dp"

            android:gravity="center"

            android:background="@drawable/widget_chip_background">

            <TextView

                android:id="@+id/widgetStreak"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="🔥 6"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- HERO CARD -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:orientation="vertical"

        android:padding="16dp"

        android:background="@drawable/widget_chip_background">

        <!-- PROGRESS -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical">

            <!-- COUNT -->

            <TextView

                android:id="@+id/widgetProgress"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="4/7"

                android:textColor="#FFD369"

                android:textStyle="bold"

                android:textSize="28sp"/>

            <!-- BAR AREA -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:paddingStart="18dp">

                <!-- PROGRESS BAR -->

                <ProgressBar

                    android:id="@+id/widgetProgressBar"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="6dp"

                    android:max="100"

                    android:progress="45"

                    android:progressDrawable="@drawable/widget_progress_drawable"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ENCOURAGEMENT -->

        <TextView

            android:id="@+id/widgetEncouragement"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="Keep going ✨"

            android:textColor="#CCFFFFFF"

            android:textSize="11sp"/>

        <!-- ANALYTICS -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:orientation="horizontal"

            android:gravity="center_vertical">

            <!-- TODAY -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:gravity="center">

                <TextView

                    android:id="@+id/widgetToday"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="4"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="22sp"/>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Today"

                    android:textColor="#CCFFFFFF"

                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- DIVIDER -->

            <View

                android:layout_width="1dp"
                android:layout_height="28dp"

                android:background="#22FFFFFF"/>

            <!-- WEEK -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:gravity="center">

                <TextView

                    android:id="@+id/widgetWeekly"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="6"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="22sp"/>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Week"

                    android:textColor="#CCFFFFFF"

                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- DIVIDER -->

            <View

                android:layout_width="1dp"
                android:layout_height="28dp"

                android:background="#22FFFFFF"/>

            <!-- MONTH -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:gravity="center">

                <TextView

                    android:id="@+id/widgetMonthly"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="16"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="22sp"/>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Month"

                    android:textColor="#CCFFFFFF"

                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>